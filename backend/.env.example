# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/exam_academic_assistant

# AI / Gemini API Configuration
GEMINI_API_KEY=
QUERY_ANALYZER_MODEL=gemini-3.6-flash
RAG_GENERATION_MODEL=gemini-3.7-flash
GEMINI_QUERY_TIMEOUT_MS=15000
GEMINI_GENERATION_TIMEOUT_MS=20000
GEMINI_MAX_RETRIES=1
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Authentication
JWT_SECRET=
